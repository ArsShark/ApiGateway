# Copy this file to .env (it is ignored by Git) and set the passwords and the keys.
# Docker Compose reads .env automatically. Variables set in the shell win over .env, and
# "--env-file" REPLACES .env, it does not add to it.
# A value with a dollar sign or a hash sign must be put in single quotes, for example
# ADMIN_PASSWORD='pa$$word#1': otherwise Compose treats "$" as a variable and cuts the value at "#".

# --- Databases: one PostgreSQL per service ---
AUTH_DB_NAME=auth_service_db
AUTH_DB_USERNAME=auth_service
AUTH_DB_PASSWORD=change-me
USER_DB_NAME=user_service_db
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me

# --- Keys ---
# The shared key of the internal endpoints (header X-Internal-Key). One value for the Gateway,
# the Authentication Service and the User Service. Generate one with:
#   openssl rand -base64 32
INTERNAL_API_KEY=change-me-internal-key

# The RSA private key that signs the tokens: PKCS#8 DER, base64, on ONE line (see the README of
# the Authentication Service, "The signing key"). The placeholder is not valid base64 on purpose:
# the Authentication Service refuses to start until it is replaced. Never commit a real key.
# A new key means a new key id: tokens signed with the old key stop working.
JWT_PRIVATE_KEY=change-me

# --- The first admin (the login is an email): set both or neither. Both empty means that no
# admin is created. The password needs at least 8 characters. ---
ADMIN_LOGIN=
ADMIN_PASSWORD=

# --- Optional. The defaults are shown. ---
#JWT_ISSUER=authentication-service
#JWT_ACCESS_TTL=PT15M
#JWT_REFRESH_TTL=P7D
#CACHE_USERS_TTL=10m

# --- Images of the two services. The defaults are what their CI pipelines publish to GHCR. To
# use an image that you built yourself ("docker build -t authentication-service:dev ." in the
# repository of the service), set its name here. ---
#AUTH_SERVICE_IMAGE=ghcr.io/arsshark/authenticationservice:latest
#USER_SERVICE_IMAGE=ghcr.io/arsshark/userservice:latest
